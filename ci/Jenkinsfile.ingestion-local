pipeline {
    agent { label 'local-docker' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    parameters {
        string(name: 'LOCAL_COMMIT', defaultValue: '', description: 'Exact committed local bundle; remote checkout deferred.')
        booleanParam(name: 'VALIDATE_ONLY', defaultValue: false, description: 'Run real tests without downloading or ingesting the dataset.')
        booleanParam(name: 'FORCE_ETL', defaultValue: false, description: 'Reprocess cached CSV to verify repeatable upserts.')
    }
    environment {
        COMPOSE_ENV_TEXT = credentials('parcialbigdata-compose-env')
    }
    stages {
        stage('Local source') {
            steps {
                script {
                    if (!(params.LOCAL_COMMIT ==~ /[0-9a-f]{40}/)) { error('Exact local commit required') }
                    deleteDir()
                    withEnv(["EXPECTED_COMMIT=${params.LOCAL_COMMIT}"]) {
                        sh 'git init -q .; git fetch --no-tags "/var/jenkins_home/local-sources/${EXPECTED_COMMIT}.bundle" HEAD; git checkout --detach FETCH_HEAD; test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"'
                    }
                }
                sh 'bash ci/ingestion.sh configure'
            }
        }
        stage('Build ingestion') { steps { sh 'bash ci/ingestion.sh build' } }
        stage('Unit and HTTP tests') {
            steps { sh 'bash ci/ingestion.sh unit' }
            post { always { junit testResults: 'reports/ingestion-unit.xml', allowEmptyResults: false } }
        }
        stage('Dask and Mongo integration') {
            steps { sh 'bash ci/ingestion.sh integration' }
            post { always { junit testResults: 'reports/ingestion-integration.xml', allowEmptyResults: false } }
        }
        stage('Kaggle download and ingestion') {
            when { expression { !params.VALIDATE_ONLY } }
            steps {
                withCredentials([string(credentialsId: 'parcialbigdata-kaggle', variable: 'KAGGLE_CREDENTIAL')]) {
                    sh 'bash ci/ingestion.sh ingest'
                }
            }
        }
    }
    post {
        always {
            script {
                if (fileExists('ci/ingestion.sh')) { sh 'bash ci/ingestion.sh cleanup' }
            }
            archiveArtifacts artifacts: 'reports/*', allowEmptyArchive: true
        }
    }
}
